{
  "name": "sharescreen",
  "productName": "ShareScreen",
  "version": "0.2.1",
  "description": "Affiche et contrôle une tablette Android et un iPhone depuis Windows 11, par USB.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "cd src-tauri && cargo test",
    "tauri": "tauri",
    "postinstall": "node scripts/fetch-binaries.mjs",
    "release": "npm run build && node scripts/make-latest.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
